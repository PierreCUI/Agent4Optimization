varf pipesteamjacketradiationResidual([incu],[deltau]) = 
    -int1d(Th, 3.00000000000000)(h*(uamb - u)*deltau) 
 - int1d(Th, 2.00000000000000)(pen*(uH - u)*deltau) 
 - int1d(Th, 3.00000000000000)(sigma*varepsilon*(uamb^4.0 - u^4.0)*deltau) 
 + int2d(Th)((1.00000000000000*(phi<0) + 0.000130000000000000*(1-(phi<0)))*k0*(dx(deltau)*dx(u) + dy(deltau)*dy(u)))
 ;