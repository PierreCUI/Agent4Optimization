varf heatsinkcoldplatetemperatureconductivityResidual([incu],[deltau]) = 
    -int1d(Th, 2.00000000000000)(q*deltau) 
 - int1d(Th, 3.00000000000000)(h*uamb*deltau) 
 + int1d(Th, 3.00000000000000)(h*deltau*u) 
 + int2d(Th)(-(1.00000000000000*(phi<0) + 0.000130000000000000*(1-(phi<0)))*k0*(beta*(uamb - u) - 1)*(dx(deltau)*dx(u) + dy(deltau)*dy(u)))
    + on(4,incu = 0)
 ;