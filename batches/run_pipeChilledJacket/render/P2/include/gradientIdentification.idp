mesh3 Th2 = trunc(Th, region==2, label=1);
meshS Th1 = Th2.Gamma;
Th1 = trunc(Th1, region==10, label=1);
fespace VhS(Th1, [P1,P1,P1]);
VhS[shX,shY,shZ];
matrix IV34 = interpolate(VhS, VhV, inside=1);
shX[] = IV34 * shapeX[];
shapeX[] = IV34' * shX[];
varf varfGradientIdentification([incux, incuy, incuz],[deltaux, deltauy, deltauz]) = int2d(Th,10)(incux*deltaux+incuy*deltauy+incuz*deltauz)
+ int2d(Th,10)(1.e-6*(dx(incux)*(1-N.x^2)*dx(deltaux)+dy(incux)*(N.y*N.x)*dx(deltaux) + dz(incux)*(N.z*N.x)*dx(deltaux)
                    + dx(incux)*(N.x*N.y)*dy(deltaux)+dy(incux)*(1-N.y^2)*dy(deltaux) + dz(incux)*(N.z*N.y)*dy(deltaux)
                    + dx(incux)*(N.x*N.z)*dz(deltaux)+dy(incux)*(N.y*N.z)*dz(deltaux) + dz(incux)*(1-N.z^2)*dz(deltaux) //
                    + dx(incuy)*(1-N.x^2)*dx(deltauy)+dy(incuy)*(N.y*N.x)*dx(deltauy) + dz(incuy)*(N.z*N.x)*dx(deltauy)
                     + dx(incuy)*(N.x*N.y)*dy(deltauy)+dy(incuy)*(1-N.y^2)*dy(deltauy) + dz(incuy)*(N.z*N.y)*dy(deltauy)
                     + dx(incuy)*(N.x*N.z)*dz(deltauy)+dy(incuy)*(N.y*N.z)*dz(deltauy) + dz(incuy)*(1-N.z^2)*dz(deltauy) //
                     + dx(incuz)*(1-N.x^2)*dx(deltauz)+dy(incuz)*(N.y*N.x)*dx(deltauz) + dz(incuz)*(N.z*N.x)*dx(deltauz)
                     + dx(incuz)*(N.x*N.y)*dy(deltauz)+dy(incuz)*(1-N.y^2)*dy(deltauz) + dz(incuz)*(N.z*N.y)*dy(deltauz)
                     + dx(incuz)*(N.x*N.z)*dz(deltauz)+dy(incuz)*(N.y*N.z)*dz(deltauz) + dz(incuz)*(1-N.z^2)*dz(deltauz)))
+ int3d(Th)(1.e-3*(dx(incux)*dx(deltaux)+dx(incuy)*dx(deltauy)+dx(incuz)*dx(deltauz)
                 + dy(incux)*dy(deltaux)+dy(incuy)*dy(deltauy)+dy(incuz)*dy(deltauz)
                 + dz(incux)*dz(deltaux)+dz(incuy)*dz(deltauy)+dz(incuz)*dz(deltauz)))
+ int2d(Th,1,2,3,4,5,6)(1.e30*(incux*N.x+incuy*N.y+incuz*N.z)*(deltaux*N.x+deltauy*N.y+deltauz*N.z));
   matrix As = varfGradientIdentification(VhV, VhV);
   set(As, solver=sparsesolver);
   real[int] solE = As^-1 * shapeX[];
   shapeX[] = -solE;