verbosity = 0;
load "iovtk"
include "include/inout.idp"
real ell = 5000.00000000000;
real uamb = 298;
real h = 25;
real q = 1000;
real k0 = 200;
// ###########################################
// ###########################################
// ###########################################
real timeStart = clock();

real L = 1.0;    // normalized design-domain width
real H = 1.0;    // normalized design-domain height
real lq = 0.2;   // half-length of the chip heat-flux segment (chip = central 40%)
border C01(t=0, L/2-lq){x=t; y=0; label=1;}         // bottom edge, adiabatic left
border C02(t=0, 2*lq){x=L/2-lq+t; y=0; label=2;}    // bottom edge, chip heat flux
border C03(t=0, L/2-lq){x=L/2+lq+t; y=0; label=1;}  // bottom edge, adiabatic right
border C04(t=0, H){x=L; y=t; label=3;}              // right edge, convection
border C05(t=0, L){x=L-t; y=H; label=3;}            // top edge, convection
border C06(t=0, H){x=0; y=H-t; label=3;}            // left edge, convection
int n = 50;
mesh Th = buildmesh(C01(n) + C02(n) + C03(n) + C04(n) + C05(n) + C06(n));func phi0 = 0.1 - sqrt((x-0.5)^2+(y-0.5)^2);
{savemesh(Th, "tmp/Mesh1.mesh");
fespace Vh1(Th, P1);
Vh1 phi;
phi = phi0;
printsol("tmp/phi.sol", phi[]);
int Res = system("mmg2d_O3 tmp/Mesh1.mesh -ls -sol tmp/phi.sol -hmin 0.25 -hmax 0.5 -hausd 0.001 -hgrad 1.3 -out tmp/newmesh.mesh -rmc -v -1");
 }
Th = readmesh("tmp/newmesh.mesh");
fespace VhPhi(Th, P1);
VhPhi phiTh;
phiTh = phi0;
func Vx = x * y + cos(4 * y);
func Vy = sin(4 * x);
func Vz = 0;
real objective = 0;
real objective0 = 0;
real shapeDerivative = 0;
{
fespace Vh1(Th,P1);
Vh1 phi, X0, X;
phi = phi0;
X0 = (phi<0); //characteristic function of the shape
// FE spaces
fespace Vhu(Th, P2);
fespace Vhdeltau(Th, P2);
// FE fields for u
Vhu u = 0.;
Vhu incu;
// adjoint variables for u
Vhu adju;
// definition of the test functions
Vhdeltau deltau;
include "include/heatsinkconvectionNewton.edp"
include "include/heatsinkconvectionResidual.edp"
   matrix A = heatsinkconvectionNewton(Vhu, Vhdeltau);
   set(A,solver=sparsesolver);
   real[int] rhs = heatsinkconvectionResidual(0,Vhdeltau);
   real[int] sol = A^-1 * rhs;
   // update state
   [incu[]] = sol; 
   u[] -= incu[];
include "include/heatsinkconvectionObjective.edp"
objective0 = objective;
// compute the adjoint and the shape derivative
include "include/heatsinkconvectionAdjoint.edp"
include "include/heatsinkconvectionShape.edp"
fespace VhV(Th, [P1, P1]);
VhV[shapeX, shapeY] = [0, 0];
shapeX[] = heatsinkconvectionShape(0, VhV);
VhV[VdiscreteX, VdiscreteY] = [Vx, Vy];
shapeDerivative = VdiscreteX[]' * shapeX[];
}
mesh Thold = Th;
ofstream fout("convergenceShapeheatsinkconvection.txt");
fout << "t, numShape, taylorShape" << endl;
for (int ii=0;ii<30;ii++){
 real t = 0.1*2.^(-real(ii));
 Th = movemesh(Thold,[x+t*Vx,y+t*Vy]);
fespace Vh1(Th,P1);
Vh1 phi, X0, X;
phi[] = phiTh[];
X0 = (phi<0); //characteristic function of the shape
// FE spaces
fespace Vhu(Th, P2);
fespace Vhdeltau(Th, P2);
// FE fields for u
Vhu u = 0.;
Vhu incu;
// definition of the test functions
Vhdeltau deltau;
include "include/heatsinkconvectionNewton.edp"
include "include/heatsinkconvectionResidual.edp"
   matrix A = heatsinkconvectionNewton(Vhu, Vhdeltau);
   set(A,solver=sparsesolver);
   real[int] rhs = heatsinkconvectionResidual(0,Vhdeltau);
   real[int] sol = A^-1 * rhs;
   // update state
   [incu[]] = sol; 
   u[] -= incu[];
include "include/heatsinkconvectionObjective.edp"
real objective1 = objective;
real shapeDerivativeNumeric = (objective1 - objective0) / t;
fout << t << ", " << abs(shapeDerivativeNumeric-shapeDerivative) / abs(shapeDerivative) <<  ", " << abs(objective1 - objective0 - t * shapeDerivative) << ", "  << endl;
cout.precision(6);
cout.scientific;
cout << "t = " << t << ",  val. FD = " << shapeDerivativeNumeric << ", val. Formula = " << shapeDerivative 
     << ", error FD = " << abs(shapeDerivativeNumeric-shapeDerivative) / abs(shapeDerivative) 
     <<  ", error expansion = " << abs(objective1 - objective0 - t * shapeDerivative) << endl;
}
