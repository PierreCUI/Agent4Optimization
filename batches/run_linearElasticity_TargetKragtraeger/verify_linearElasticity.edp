verbosity = 0;
load "iovtk"
include "include/inout.idp"
real nu = 0.300000000000000;
real E = 2000.00000000000;
real c = 10000000000.0000;
real f = -10;
// ###########################################
// ###########################################
// ###########################################
real timeStart = clock();

border C1(t=0, 1.){x=t*2.0; y=0.0; label=1;}
border C2(t=0, 1.){x=2.; y=t; label=2;}
border C3(t=0, 1.){x=2.0-t*2; y=1.0; label=3;}
border C4(t=0, 1.){x=0; y=1.0-t; label=4;}
real a = 0.6;
border C11(t=0, a){x=0.2+t; y=0.20; label=10;}
border C12(t=0, a){x=0.2+a; y=0.2+t; label=10;}
border C13(t=0, a){x=0.2+a-t; y=0.2+a; label=10;}
border C14(t=0, a){x=0.2; y=0.2+a-t; label=10;}
int n = 60;
mesh Th = buildmesh(C1(n) + C2(n) + C3(n) + C4(n) + C11(n) + C12(n) + C13(n) + C14(n));
int[int] re = [0,3]; //the inner region has to have the label 3!
Th = change(Th,reft=re);
func phi0 = 0.02*(x+0.5)^2+(y-0.5)^2-0.10;
{savemesh(Th, "tmp/Mesh1.mesh");
fespace Vh1(Th, P1);
Vh1 phi;
phi = phi0;
printsol("tmp/phi.sol", phi[]);
int Res = system("mmg2d_O3 tmp/Mesh1.mesh -ls -sol tmp/phi.sol -hmin 0.25 -hmax 0.5 -hausd 0.001 -hgrad 1.3 -out tmp/newmesh.mesh -rmc -v -1");
 }
Th = readmesh("tmp/newmesh.mesh");
fespace VhPhi(Th, P1);
VhPhi phiTh;
phiTh = phi0;
func Vx = x * y + cos(4 * y);
func Vy = sin(4 * x);
func Vz = 0;
real objective = 0;
real objective0 = 0;
real shapeDerivative = 0;
{
fespace Vh1(Th,P1);
Vh1 phi, X0, X;
phi = phi0;
X0 = (phi<0); //characteristic function of the shape
// FE spaces
fespace Vhu(Th, [P2, P2]);
fespace Vhdeltau(Th, [P2, P2]);
// FE fields for u
Vhu [ux, uy] = [0.,0.];
Vhu [incux, incuy];
// adjoint variables for u
Vhu [adjux, adjuy];
// definition of the test functions
Vhdeltau [deltaux, deltauy];
include "include/linearElasticityNewton.edp"
include "include/linearElasticityResidual.edp"
   matrix A = linearElasticityNewton(Vhu, Vhdeltau);
   set(A,solver=sparsesolver);
   real[int] rhs = linearElasticityResidual(0,Vhdeltau);
   real[int] sol = A^-1 * rhs;
   // update state
   [incux[]] = sol; 
   ux[] -= incux[];
include "include/linearElasticityObjective.edp"
objective0 = objective;
// compute the adjoint and the shape derivative
include "include/linearElasticityAdjoint.edp"
include "include/linearElasticityShape.edp"
fespace VhV(Th, [P1, P1]);
VhV[shapeX, shapeY] = [0, 0];
shapeX[] = linearElasticityShape(0, VhV);
VhV[VdiscreteX, VdiscreteY] = [Vx, Vy];
shapeDerivative = VdiscreteX[]' * shapeX[];
}
mesh Thold = Th;
ofstream fout("convergenceShapelinearElasticity.txt");
fout << "t, numShape, taylorShape" << endl;
for (int ii=0;ii<30;ii++){
 real t = 0.1*2.^(-real(ii));
 Th = movemesh(Thold,[x+t*Vx,y+t*Vy]);
fespace Vh1(Th,P1);
Vh1 phi, X0, X;
phi[] = phiTh[];
X0 = (phi<0); //characteristic function of the shape
// FE spaces
fespace Vhu(Th, [P2, P2]);
fespace Vhdeltau(Th, [P2, P2]);
// FE fields for u
Vhu [ux, uy] = [0.,0.];
Vhu [incux, incuy];
// definition of the test functions
Vhdeltau [deltaux, deltauy];
include "include/linearElasticityNewton.edp"
include "include/linearElasticityResidual.edp"
   matrix A = linearElasticityNewton(Vhu, Vhdeltau);
   set(A,solver=sparsesolver);
   real[int] rhs = linearElasticityResidual(0,Vhdeltau);
   real[int] sol = A^-1 * rhs;
   // update state
   [incux[]] = sol; 
   ux[] -= incux[];
include "include/linearElasticityObjective.edp"
real objective1 = objective;
real shapeDerivativeNumeric = (objective1 - objective0) / t;
fout << t << ", " << abs(shapeDerivativeNumeric-shapeDerivative) / abs(shapeDerivative) <<  ", " << abs(objective1 - objective0 - t * shapeDerivative) << ", "  << endl;
cout.precision(6);
cout.scientific;
cout << "t = " << t << ",  val. FD = " << shapeDerivativeNumeric << ", val. Formula = " << shapeDerivative 
     << ", error FD = " << abs(shapeDerivativeNumeric-shapeDerivative) / abs(shapeDerivative) 
     <<  ", error expansion = " << abs(objective1 - objective0 - t * shapeDerivative) << endl;
}
