verbosity = 0;
load "iovtk"
include "include/inout.idp"
load "msh3"
int maximalNumberOfIterations=100;	//maximal number of iterations
real v0 = 0.0002;
real diffusion = 5e-05;
real objective = 0;
real hmin = 0.01;
real hmax = 0.02;
real[int] objectivehistory(maximalNumberOfIterations);
// definition of constants
real ell = 0.25;
real nu = 0.3;
real E = 200.0;
real f = -10.0;
// definition of the hold all domain Th (file mesh.txt)
border C01(t=0, 2.){x=t; y=0; label=1;}

border C02(t=0, 0.45){x=2.; y=t; label=1;}

border C03(t=0, 0.1){x=2.; y=0.45+t; label=2;}

border C04(t=0, 0.45){x=2.; y=0.55+t; label=1;}

border C05(t=0, 2){x=2.-t; y=1.; label=1;}

border C06(t=0, 1){x=0.; y=1-t; label=4;}

int n = 60;

mesh Th = buildmesh(C01(n) + C02(n) + C03(n) + C04(n) + C05(n) + C06(n));
// ////////////////////////////
// adapt the mesh to the level-set function phi
{
fespace Vh1(Th, P1);
Vh1 phi;
func phi0 = -0.4 - sin(pi * 3 * (x+0.5)) * cos(pi * 6 * y);
phi = phi0;
printsol("tmp/phi.sol",phi[]);
savemesh(Th,"tmp/initialMesh.mesh");
int Res = system("mmg2d_O3 tmp/initialMesh.mesh -ls -sol tmp/phi.sol -hmin " + hmin + " -hmax " + hmax + " -hausd 0.001 -hgrad 1.3 -out tmp/newmesh.mesh -rmc -v -1");
Res = system("mshdist tmp/newmesh.mesh -dom -fmm -v 0");
}
Th = readmesh("tmp/newmesh.mesh");
fespace Vh1(Th,P1);
Vh1 phi;
loadsol("tmp/newmesh.sol", phi[]);
// FE spaces
fespace Vhu(Th, [P2, P2]);
fespace Vhv(Th, [P2, P2]);
// FE fields for u
Vhu [ux, uy] = [0.,0.];
Vhu [incux, incuy];
// adjoint variables for u
Vhu [adjux, adjuy];
// definition of the test functions
Vhv [vx, vy];
include "include/nonlinearElasticitySaintVenantNewton.edp"
include "include/nonlinearElasticitySaintVenantResidual.edp"
include "include/nonlinearElasticitySaintVenantShape.edp"
// Solve the nonlinear state problem and compute the objective for initialisation
for (int i=0; i < 40; i++){
cout << "	iteration = " << i << endl;
   real timeBeforeAssamblyNewton = clock();
   matrix A = nonlinearElasticitySaintVenantNewton(Vhu, Vhv);
   cout << "	Time for assambly = " << clock() - timeBeforeAssamblyNewton << endl; timeBeforeAssamblyNewton = clock();
   set(A,solver=sparsesolver);
   {ofstream file("u.txt");   file << ux[]; }
   real[int] rhs = nonlinearElasticitySaintVenantResidual(0,Vhv);
   real[int] sol = A^-1 * rhs;
   cout << "	Time for solve = " << clock() - timeBeforeAssamblyNewton << endl;
   // update state
   [incux[]] = sol; 
   real alphaLineSearch = 1.0;
   ux[] -= alphaLineSearch*incux[];
   cout << "maximal increment: " << sol.linfty << "   maximal residuum: " << rhs.linfty << endl;
   if ((rhs.linfty < 1e-6)*(sol.linfty < 1e-5)){ 
      cout << "CONVERGED after " << i << " steps!" << endl;
   break;
   };
};
include "include/nonlinearElasticitySaintVenantObjective.edp"
// Output the initialisation
{  int iter=0;
mesh Thtrunc = trunc(Th, region == 3);
string DataNameTh = "u";
int[int] OrderTh = [1,1];
savevtk("results/resultnonlinearElasticitySaintVenantTh" + iter + ".vtu", Thtrunc, [ux,uy,0.],   dataname=DataNameTh, order=OrderTh);
}
// Create file for convergence history
{ ofstream fout("objectivenonlinearElasticitySaintVenant.txt");
 fout << "iteration, objective" << endl; 
}
real shapeVelocity = v0;
real minObjective = objective;
objectivehistory[0] = objective;
// //////////////////////////
//start the optimization loop
// //////////////////////////
for (int iter=1;iter< maximalNumberOfIterations;iter=iter+1)
{
v0 = 1.05*v0;
cout << "//////////////////////////////////////////////" << endl;
cout << "iteration = " << iter << endl;
cout << "previous objective = " << objective << endl;
cout << "v0 = " << v0 << endl;
{ ofstream fout("objectivenonlinearElasticitySaintVenant.txt",append);
 fout << iter-1 << ", " << objective << endl;}
real oldObjective = objective; 
// compute the adjoint and the shape derivative
include "include/nonlinearElasticitySaintVenantAdjoint.edp"
fespace VhV(Th, [P1,P1]);
VhV[shapeX,shapeY];
shapeX[] = nonlinearElasticitySaintVenantShape(0, VhV);
// gradient identification
 int[int] llabs = [10];
 meshL ThLshape = extract(Th, label=llabs);
 fespace Vh10(ThLshape, [P1,P1]);
 Vh10[shX,shY];
 matrix IV34 = interpolate(Vh10, VhV, inside=1);
 shX[] = IV34 * shapeX[];
 shapeX[] = IV34'*shX[];
 varf varfelast([incux, incuy],[deltaux, deltauy]) = int2d(Th)((incux*deltaux+incuy*deltauy)) 
 
 + int2d(Th)(diffusion*(dx(deltaux) + dy(deltauy))*(dx(incux) + dy(incuy)) + 2*diffusion*(2*(dy(incux) + dx(incuy))/2*(dy(deltaux) + dx(deltauy))/2 + dx(deltaux)*dx(incux) + dy(deltauy)*dy(incuy))) 

 + int1d(Th,1,4)(1.e20*(incux*N.x+incuy*N.y)*(deltaux*N.x+deltauy*N.y)) + on(2,incux=0,incuy=0);
   matrix As = varfelast(VhV, VhV);
   set(As, solver=sparsesolver);
   real[int] solE = As^-1 * shapeX[];
   shapeX[] = -solE;
 string DataNameF = " u adju phi shape";
mesh Tht = trunc(Th,region == 3);
int[int] OrderTNS = [1, 1, 1, 1, 1, 1, 1];
savevtk("results/result-nonlinearElasticitySaintVenant-" + iter +".vtu", Tht, [ux,uy,0.], [adjux,adjuy,0.], phi, [shapeX, shapeY,0], dataname=DataNameF, order=OrderTNS);
// write the mesh, phi, and the shape gradient to disk
savemesh(Th, "tmp/mesh2D.mesh");
printsol("tmp/phi.sol",phi[]);
printvec2("tmp/vel.sol", shapeX[]);
mesh Thold = Th;
fespace VhVold(Thold, [P1, P1]);
VhVold[shapeX2, shapeY2];
shapeVelocity = v0;
for (int iterLineSearch=0;iterLineSearch < 5;iterLineSearch=iterLineSearch+1){
shapeX2[] = shapeVelocity*shapeX[];
cout << "using step size: " << shapeVelocity << endl;
printvec2("tmp/vel.sol", shapeX2[]);
int Res = system("advect tmp/mesh2D.mesh -s tmp/vel.sol -c tmp/phi.sol -dt " + 1 + " -o tmp/newphi.sol -nocfl -v");
cout << "ADVECT run " << Res << endl;
Res = system("mmg2d_O3 tmp/mesh2D.mesh -ls -sol tmp/newphi.sol -hmin " + hmin + " -hmax " + hmax + " -hausd 0.001 -hgrad 1.3 -out tmp/newmesh.mesh -rmc -v -1");
cout << "MMG run " << Res << endl;
Res = system("mshdist tmp/newmesh.mesh -dom -fmm -v 0");
Th = readmesh("tmp/newmesh.mesh");
phi = phi;
loadsol("tmp/newmesh.sol", phi[]);
[ux,uy] = [ux,uy];
[ux, uy] = [0.,0.];
[incux,incuy]=[incux,incuy];
[vx,vy]=[vx,vy];
[adjux,adjuy]=[adjux,adjuy];
cout << "resolve state on new mesh" << endl;
for (int i=0; i < 40; i++){
cout << "	iteration = " << i << endl;
   real timeBeforeAssamblyNewton = clock();
   matrix A = nonlinearElasticitySaintVenantNewton(Vhu, Vhv);
   cout << "	Time for assambly = " << clock() - timeBeforeAssamblyNewton << endl; timeBeforeAssamblyNewton = clock();
   set(A,solver=sparsesolver);
   {ofstream file("u.txt");   file << ux[]; }
   real[int] rhs = nonlinearElasticitySaintVenantResidual(0,Vhv);
   real[int] sol = A^-1 * rhs;
   cout << "	Time for solve = " << clock() - timeBeforeAssamblyNewton << endl;
   // update state
   [incux[]] = sol; 
   real alphaLineSearch = 1.0;
   ux[] -= alphaLineSearch*incux[];
   cout << "maximal increment: " << sol.linfty << "   maximal residuum: " << rhs.linfty << endl;
   if ((rhs.linfty < 1e-6)*(sol.linfty < 1e-5)){ 
      cout << "CONVERGED after " << i << " steps!" << endl;
   break;
   };
};
include "include/nonlinearElasticitySaintVenantObjective.edp"
if (minObjective > objective){
minObjective = objective;
savemesh(Th,"tmp/optimaldesign.mesh");
mesh Thtrunc = trunc(Th, region == 3);
string DataNameTh = "u";
int[int] OrderTh = [1,1];
savevtk("results/resultnonlinearElasticitySaintVenantMinTh.vtu", Thtrunc, [ux,uy,0.], dataname=DataNameTh, order=OrderTh);
}
cout << "old objective: " << oldObjective << "   new objective: " << objective << endl;
if (oldObjective > objective){
   if (iterLineSearch == 0)
      cout << "step accepted without line search" << endl;
   else
      cout << "step accepted after " + iterLineSearch +  " line search steps" << endl;
   objectivehistory[iter] = objective;
   break;
}
else{
   cout << "step size reduced after " + iterLineSearch +  " line search steps" << endl;
   shapeVelocity=shapeVelocity/2;
   v0=v0*0.75;
}
} // end of line search
mesh Thtrunc = trunc(Th, region == 3);
string DataNameTh = "u";
int[int] OrderTh = [1,1];
savevtk("results/resultnonlinearElasticitySaintVenantTh" + iter + ".vtu", Thtrunc, [ux,uy,0.],   dataname=DataNameTh, order=OrderTh);
}
exit;
