varf nonlinearElasticitySaintVenantResidual([incux, incuy],[vx, vy]) = 
    -int1d(Th, 2)(f*vy) 
 + int2d(Th)(-0.5*(1.00000000000000*(phi<0) + 0.0100000000000000*(1-(phi<0)))*E*(-(2.0*nu - 1)*((dx(ux) + 1.0)*dy(ux) + (dy(uy) + 1.0)*dx(uy))*((dx(ux) + 1.0)*dy(vx) + (dy(uy) + 1.0)*dx(vy) + dy(ux)*dx(vx) + dx(uy)*dy(vy)) + (nu*((dx(ux) + 1.0)^2.0 + (dy(uy) + 1.0)^2.0 + dy(ux)^2.0 + dx(uy)^2.0 - 2.0) - (2.0*nu - 1)*((dx(ux) + 1.0)^2.0 + dx(uy)^2.0 - 1))*((dx(ux) + 1.0)*dx(vx) + dx(uy)*dx(vy)) + (nu*((dx(ux) + 1.0)^2.0 + (dy(uy) + 1.0)^2.0 + dy(ux)^2.0 + dx(uy)^2.0 - 2.0) - (2.0*nu - 1)*((dy(uy) + 1.0)^2.0 + dy(ux)^2.0 - 1))*((dy(uy) + 1.0)*dy(vy) + dy(ux)*dy(vx)))/((nu + 1.0)*(2.0*nu - 1)))
    + on(4,incux = 0)
    + on(4,incuy = 0)
 ;