varf nonlinearElasticitySaintVenantAdjoint([adjux, adjuy],[vx, vy]) = 
    int2d(Th)(8.0*(1.00000000000000*(phi<0) + 0.0100000000000000*(1-(phi<0)))*E*(0.5*(dx(ux) + 1.0)*dy(ux) + 0.5*(dy(uy) + 1.0)*dx(uy))*(0.5*(dx(ux) + 1.0)*dy(vx) + 0.5*(dy(uy) + 1.0)*dx(vy) + 0.5*dy(ux)*dx(vx) + 0.5*dx(uy)*dy(vy))/(2.0*nu + 2.0) + (1.00000000000000*(phi<0) + 0.0100000000000000*(1-(phi<0)))*((dx(ux) + 1.0)*dx(vx) + dx(uy)*dx(vy))*(E*nu*(0.5*(dx(ux) + 1.0)^2.0 + 0.5*(dy(uy) + 1.0)^2.0 + 0.5*dy(ux)^2.0 + 0.5*dx(uy)^2.0 - 1)/((1.0 - 2.0*nu)*(nu + 1.0)) + 2.0*E*(0.5*(dx(ux) + 1.0)^2.0 + 0.5*dx(uy)^2.0 - 0.5)/(2.0*nu + 2.0)) + (1.00000000000000*(phi<0) + 0.0100000000000000*(1-(phi<0)))*((dy(uy) + 1.0)*dy(vy) + dy(ux)*dy(vx))*(E*nu*(0.5*(dx(ux) + 1.0)^2.0 + 0.5*(dy(uy) + 1.0)^2.0 + 0.5*dy(ux)^2.0 + 0.5*dx(uy)^2.0 - 1)/((1.0 - 2.0*nu)*(nu + 1.0)) + 2.0*E*(0.5*(dy(uy) + 1.0)^2.0 + 0.5*dy(ux)^2.0 - 0.5)/(2.0*nu + 2.0)) + (1.00000000000000*(phi<0) + 0.0100000000000000*(1-(phi<0)))*(E*nu*((dx(ux) + 1.0)*dx(vx) + (dy(uy) + 1.0)*dy(vy) + dy(ux)*dy(vx) + dx(uy)*dx(vy))/((1.0 - 2.0*nu)*(nu + 1.0)) + 2.0*E*((dx(ux) + 1.0)*dx(vx) + dx(uy)*dx(vy))/(2.0*nu + 2.0))*(0.5*(dx(ux) + 1.0)^2.0 + 0.5*dx(uy)^2.0 - 0.5) + (1.00000000000000*(phi<0) + 0.0100000000000000*(1-(phi<0)))*(E*nu*((dx(ux) + 1.0)*dx(vx) + (dy(uy) + 1.0)*dy(vy) + dy(ux)*dy(vx) + dx(uy)*dx(vy))/((1.0 - 2.0*nu)*(nu + 1.0)) + 2.0*E*((dy(uy) + 1.0)*dy(vy) + dy(ux)*dy(vx))/(2.0*nu + 2.0))*(0.5*(dy(uy) + 1.0)^2.0 + 0.5*dy(ux)^2.0 - 0.5)) 
 + int2d(Th)(2.0*(1.00000000000000*(phi<0) + 0.0100000000000000*(1-(phi<0)))*E*((dx(ux) + 1.0)*dy(adjux) + dy(adjuy)*dx(uy))*(0.5*(dx(ux) + 1.0)*dy(vx) + 0.5*(dy(uy) + 1.0)*dx(vy) + 0.5*dy(ux)*dx(vx) + 0.5*dx(uy)*dy(vy))/(2.0*nu + 2.0) + 2.0*(1.00000000000000*(phi<0) + 0.0100000000000000*(1-(phi<0)))*E*(0.5*(dx(ux) + 1.0)*dy(ux) + 0.5*(dy(uy) + 1.0)*dx(uy))*(dx(adjux)*dy(vx) + dx(adjuy)*dy(vy))/(2.0*nu + 2.0) + 2.0*(1.00000000000000*(phi<0) + 0.0100000000000000*(1-(phi<0)))*E*(0.5*(dx(ux) + 1.0)*dy(ux) + 0.5*(dy(uy) + 1.0)*dx(uy))*(dy(adjux)*dx(vx) + dy(adjuy)*dx(vy))/(2.0*nu + 2.0) + 2.0*(1.00000000000000*(phi<0) + 0.0100000000000000*(1-(phi<0)))*E*((dy(uy) + 1.0)*dx(adjuy) + dx(adjux)*dy(ux))*(0.5*(dx(ux) + 1.0)*dy(vx) + 0.5*(dy(uy) + 1.0)*dx(vy) + 0.5*dy(ux)*dx(vx) + 0.5*dx(uy)*dy(vy))/(2.0*nu + 2.0) + (1.00000000000000*(phi<0) + 0.0100000000000000*(1-(phi<0)))*((dx(ux) + 1.0)*dx(adjux) + dx(adjuy)*dx(uy))*(E*nu*((dx(ux) + 1.0)*dx(vx) + (dy(uy) + 1.0)*dy(vy) + dy(ux)*dy(vx) + dx(uy)*dx(vy))/((1.0 - 2.0*nu)*(nu + 1.0)) + 2.0*E*((dx(ux) + 1.0)*dx(vx) + dx(uy)*dx(vy))/(2.0*nu + 2.0)) + (1.00000000000000*(phi<0) + 0.0100000000000000*(1-(phi<0)))*((dy(uy) + 1.0)*dy(adjuy) + dy(adjux)*dy(ux))*(E*nu*((dx(ux) + 1.0)*dx(vx) + (dy(uy) + 1.0)*dy(vy) + dy(ux)*dy(vx) + dx(uy)*dx(vy))/((1.0 - 2.0*nu)*(nu + 1.0)) + 2.0*E*((dy(uy) + 1.0)*dy(vy) + dy(ux)*dy(vx))/(2.0*nu + 2.0)) + (1.00000000000000*(phi<0) + 0.0100000000000000*(1-(phi<0)))*(dx(adjux)*dx(vx) + dx(adjuy)*dx(vy))*(E*nu*(0.5*(dx(ux) + 1.0)^2.0 + 0.5*(dy(uy) + 1.0)^2.0 + 0.5*dy(ux)^2.0 + 0.5*dx(uy)^2.0 - 1)/((1.0 - 2.0*nu)*(nu + 1.0)) + 2.0*E*(0.5*(dx(ux) + 1.0)^2.0 + 0.5*dx(uy)^2.0 - 0.5)/(2.0*nu + 2.0)) + (1.00000000000000*(phi<0) + 0.0100000000000000*(1-(phi<0)))*(dy(adjux)*dy(vx) + dy(adjuy)*dy(vy))*(E*nu*(0.5*(dx(ux) + 1.0)^2.0 + 0.5*(dy(uy) + 1.0)^2.0 + 0.5*dy(ux)^2.0 + 0.5*dx(uy)^2.0 - 1)/((1.0 - 2.0*nu)*(nu + 1.0)) + 2.0*E*(0.5*(dy(uy) + 1.0)^2.0 + 0.5*dy(ux)^2.0 - 0.5)/(2.0*nu + 2.0)))
    + on(4,adjux = 0)
    + on(4,adjuy = 0);

   matrix adjointMatrix = nonlinearElasticitySaintVenantAdjoint(Vhu, Vhu);
   set(adjointMatrix, solver=sparsesolver);
   real[int] adjointrhs = nonlinearElasticitySaintVenantAdjoint(0,Vhu);
   real[int] adjointsol = adjointMatrix^-1 * adjointrhs;
   adjointsol = -adjointsol; 
   [adjux[]] = adjointsol; 
