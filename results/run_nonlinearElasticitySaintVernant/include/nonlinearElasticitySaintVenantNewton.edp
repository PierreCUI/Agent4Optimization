varf nonlinearElasticitySaintVenantNewton([incux, incuy],[vx, vy]) = 
    int2d(Th)(0.5*(1.00000000000000*(phi<0) + 0.0100000000000000*(1-(phi<0)))*E*((2.0*nu - 1)*(((dx(ux) + 1.0)*dy(ux) + (dy(uy) + 1.0)*dx(uy))*(dx(incux)*dy(vx) + dx(incuy)*dy(vy)) + ((dx(ux) + 1.0)*dy(ux) + (dy(uy) + 1.0)*dx(uy))*(dy(incux)*dx(vx) + dy(incuy)*dx(vy)) + ((dx(ux) + 1.0)*dy(vx) + dx(uy)*dy(vy))*((dx(ux) + 1.0)*dy(incux) + (dy(uy) + 1.0)*dx(incuy) + dx(incux)*dy(ux) + dy(incuy)*dx(uy)) + ((dy(uy) + 1.0)*dx(vy) + dy(ux)*dx(vx))*((dx(ux) + 1.0)*dy(incux) + (dy(uy) + 1.0)*dx(incuy) + dx(incux)*dy(ux) + dy(incuy)*dx(uy))) - 2.0*(nu*((dx(ux) + 1.0)*dx(incux) + (dy(uy) + 1.0)*dy(incuy) + dy(incux)*dy(ux) + dx(incuy)*dx(uy)) - (2.0*nu - 1)*((dx(ux) + 1.0)*dx(incux) + dx(incuy)*dx(uy)))*((dx(ux) + 1.0)*dx(vx) + dx(uy)*dx(vy)) - 2.0*(nu*((dx(ux) + 1.0)*dx(incux) + (dy(uy) + 1.0)*dy(incuy) + dy(incux)*dy(ux) + dx(incuy)*dx(uy)) - (2.0*nu - 1)*((dy(uy) + 1.0)*dy(incuy) + dy(incux)*dy(ux)))*((dy(uy) + 1.0)*dy(vy) + dy(ux)*dy(vx)) - (nu*((dx(ux) + 1.0)^2.0 + (dy(uy) + 1.0)^2.0 + dy(ux)^2.0 + dx(uy)^2.0 - 2.0) - (2.0*nu - 1)*((dx(ux) + 1.0)^2.0 + dx(uy)^2.0 - 1))*(dx(incux)*dx(vx) + dx(incuy)*dx(vy)) - (nu*((dx(ux) + 1.0)^2.0 + (dy(uy) + 1.0)^2.0 + dy(ux)^2.0 + dx(uy)^2.0 - 2.0) - (2.0*nu - 1)*((dy(uy) + 1.0)^2.0 + dy(ux)^2.0 - 1))*(dy(incux)*dy(vx) + dy(incuy)*dy(vy)))/((nu + 1.0)*(2.0*nu - 1)))
    + on(4,incux = 0)
    + on(4,incuy = 0)
 ;