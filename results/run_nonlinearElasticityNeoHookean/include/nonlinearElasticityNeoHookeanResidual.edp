varf nonlinearElasticityNeoHookeanResidual([incux, incuy],[vx, vy]) = 
    -int1d(Th, 2)(f*vy) 
 + int2d(Th)((1.00000000000000*(phi<0) + 0.0100000000000000*(1-(phi<0)))*(E/(2.0*nu + 2.0) + (0.5*E*nu*((dx(ux)*dy(uy) + dx(ux) - dy(ux)*dx(uy) + dy(uy) + 1.0)^2.0 - 1)/((1.0 - 2.0*nu)*(nu + 1.0)) - E/(2.0*nu + 2.0))*(2.0*dx(ux) + dx(ux)^2.0 + dx(uy)^2.0 + 1.0)/(-2.0*dx(ux)*dy(ux)*dx(uy)*dy(uy) - 2.0*dx(ux)*dy(ux)*dx(uy) + 4.0*dx(ux)*dy(uy) + 2.0*dx(ux)*dy(uy)^2.0 + 2.0*dx(ux) + 2.0*dx(ux)^2.0*dy(uy) + dx(ux)^2.0*dy(uy)^2.0 + dx(ux)^2.0 - 2.0*dy(ux)*dx(uy)*dy(uy) - 2.0*dy(ux)*dx(uy) + dy(ux)^2.0*dx(uy)^2.0 + 2.0*dy(uy) + dy(uy)^2.0 + 1.0))*((dy(uy) + 1.0)*dy(vy) + dy(ux)*dy(vx)) + (1.00000000000000*(phi<0) + 0.0100000000000000*(1-(phi<0)))*(E/(2.0*nu + 2.0) + (0.5*E*nu*((dx(ux)*dy(uy) + dx(ux) - dy(ux)*dx(uy) + dy(uy) + 1.0)^2.0 - 1)/((1.0 - 2.0*nu)*(nu + 1.0)) - E/(2.0*nu + 2.0))*(dy(ux)^2.0 + 2.0*dy(uy) + dy(uy)^2.0 + 1.0)/(-2.0*dx(ux)*dy(ux)*dx(uy)*dy(uy) - 2.0*dx(ux)*dy(ux)*dx(uy) + 4.0*dx(ux)*dy(uy) + 2.0*dx(ux)*dy(uy)^2.0 + 2.0*dx(ux) + 2.0*dx(ux)^2.0*dy(uy) + dx(ux)^2.0*dy(uy)^2.0 + dx(ux)^2.0 - 2.0*dy(ux)*dx(uy)*dy(uy) - 2.0*dy(ux)*dx(uy) + dy(ux)^2.0*dx(uy)^2.0 + 2.0*dy(uy) + dy(uy)^2.0 + 1.0))*((dx(ux) + 1.0)*dx(vx) + dx(uy)*dx(vy)) + (1.00000000000000*(phi<0) + 0.0100000000000000*(1-(phi<0)))*((dx(ux) + 1.0)*dy(vx) + dx(uy)*dy(vy))*(0.5*E*nu*((dx(ux)*dy(uy) + dx(ux) - dy(ux)*dx(uy) + dy(uy) + 1.0)^2.0 - 1)/((1.0 - 2.0*nu)*(nu + 1.0)) - E/(2.0*nu + 2.0))*(-dx(ux)*dy(ux) - dy(ux) - dx(uy)*dy(uy) - dx(uy))/(-2.0*dx(ux)*dy(ux)*dx(uy)*dy(uy) - 2.0*dx(ux)*dy(ux)*dx(uy) + 4.0*dx(ux)*dy(uy) + 2.0*dx(ux)*dy(uy)^2.0 + 2.0*dx(ux) + 2.0*dx(ux)^2.0*dy(uy) + dx(ux)^2.0*dy(uy)^2.0 + dx(ux)^2.0 - 2.0*dy(ux)*dx(uy)*dy(uy) - 2.0*dy(ux)*dx(uy) + dy(ux)^2.0*dx(uy)^2.0 + 2.0*dy(uy) + dy(uy)^2.0 + 1.0) + (1.00000000000000*(phi<0) + 0.0100000000000000*(1-(phi<0)))*((dy(uy) + 1.0)*dx(vy) + dy(ux)*dx(vx))*(0.5*E*nu*((dx(ux)*dy(uy) + dx(ux) - dy(ux)*dx(uy) + dy(uy) + 1.0)^2.0 - 1)/((1.0 - 2.0*nu)*(nu + 1.0)) - E/(2.0*nu + 2.0))*(-dx(ux)*dy(ux) - dy(ux) - dx(uy)*dy(uy) - dx(uy))/(-2.0*dx(ux)*dy(ux)*dx(uy)*dy(uy) - 2.0*dx(ux)*dy(ux)*dx(uy) + 4.0*dx(ux)*dy(uy) + 2.0*dx(ux)*dy(uy)^2.0 + 2.0*dx(ux) + 2.0*dx(ux)^2.0*dy(uy) + dx(ux)^2.0*dy(uy)^2.0 + dx(ux)^2.0 - 2.0*dy(ux)*dx(uy)*dy(uy) - 2.0*dy(ux)*dx(uy) + dy(ux)^2.0*dx(uy)^2.0 + 2.0*dy(uy) + dy(uy)^2.0 + 1.0))
    + on(4,incux = 0)
    + on(4,incuy = 0)
 ;