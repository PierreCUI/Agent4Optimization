varf linearElasticityTargetShape([Ax, Ay],[Vx, Vy], tgv=-2) = 
    -int1d(Th, 999.000000000000)(c*(N.x*(N.x*dx(Vx) + N.y*dx(Vy)) + N.y*(N.x*dy(Vx) + N.y*dy(Vy)))*(adjux*ux + adjuy*uy)) 
 + int1d(Th, 999.000000000000)(c*(adjux*ux + adjuy*uy)*(dx(Vx) + dy(Vy))) 
 - int2d(Th)((1.00000000000000*(phi<0) + 0*(1-(phi<0)))*f*(dx(Vx) + dy(Vy))*adjuy) 
 + int2d(Th)(0.5*(1.00000000000000*(phi<0) + 0.0100000000000000*(1-(phi<0)))*E*(-(2.0*nu - 1)*((dx(Vx)*dx(adjuy) + dx(Vy)*dy(adjuy))*(dy(ux) + dx(uy)) + (dy(Vx)*dx(adjux) + dy(Vy)*dy(adjux))*(dy(ux) + dx(uy)) + (dx(Vx)*dx(uy) + dy(Vx)*dx(ux) + dx(Vy)*dy(uy) + dy(Vy)*dy(ux))*dy(adjux) + (dx(Vx)*dx(uy) + dy(Vx)*dx(ux) + dx(Vy)*dy(uy) + dy(Vy)*dy(ux))*dx(adjuy)) + 2.0*(nu*(dx(ux) + dy(uy)) - (2.0*nu - 1)*dx(ux))*(dx(Vx)*dx(adjux) + dx(Vy)*dy(adjux)) + 2.0*(nu*(dx(ux) + dy(uy)) - (2.0*nu - 1)*dy(uy))*(dy(Vx)*dx(adjuy) + dy(Vy)*dy(adjuy)) + 2.0*(nu*(dx(Vx)*dx(ux) + dy(Vx)*dx(uy) + dx(Vy)*dy(ux) + dy(Vy)*dy(uy)) - (2.0*nu - 1)*(dx(Vx)*dx(ux) + dx(Vy)*dy(ux)))*dx(adjux) + 2.0*(nu*(dx(Vx)*dx(ux) + dy(Vx)*dx(uy) + dx(Vy)*dy(ux) + dy(Vy)*dy(uy)) - (2.0*nu - 1)*(dy(Vx)*dx(uy) + dy(Vy)*dy(uy)))*dy(adjuy) + (dx(Vx) + dy(Vy))*((2.0*nu - 1)*(dy(adjux) + dx(adjuy))*(dy(ux) + dx(uy)) - 2.0*(nu*(dx(ux) + dy(uy)) - (2.0*nu - 1)*dx(ux))*dx(adjux) - 2.0*(nu*(dx(ux) + dy(uy)) - (2.0*nu - 1)*dy(uy))*dy(adjuy)))/((nu + 1.0)*(2.0*nu - 1))) 
 + int2d(Th)((0.04*(x + ux + 0.5)*Vx + 2.0*(y + uy - 0.5)*Vy)*(dx(ux)*dy(uy) + dx(ux) - dy(ux)*dx(uy) + dy(uy) + 1.0) + (dx(Vx) + dy(Vy))*(0.02*(x + ux + 0.5)^2.0 + (y + uy - 0.5)^2.0 - 0.1)*(dx(ux)*dy(uy) + dx(ux) - dy(ux)*dx(uy) + dy(uy) + 1.0) - (0.02*(x + ux + 0.5)^2.0 + (y + uy - 0.5)^2.0 - 0.1)*((dx(Vx)*dx(ux) + dx(Vy)*dy(ux))*(dy(uy) + 1.0) - (dx(Vx)*dx(uy) + dx(Vy)*dy(uy))*dy(ux) - (dy(Vx)*dx(ux) + dy(Vy)*dy(ux))*dx(uy) + (dy(Vx)*dx(uy) + dy(Vy)*dy(uy))*(dx(ux) + 1.0)));