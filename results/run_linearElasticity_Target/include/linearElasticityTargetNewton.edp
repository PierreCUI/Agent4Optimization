varf linearElasticityTargetNewton([incux, incuy],[deltaux, deltauy]) = 
    int1d(Th, 999.000000000000)(c*(deltaux*incux + deltauy*incuy)) 
 + int2d(Th)(0.5*(1.00000000000000*(phi<0) + 0.0100000000000000*(1-(phi<0)))*E*((2.0*nu - 1)*(dy(deltaux) + dx(deltauy))*(dy(incux) + dx(incuy)) - 2.0*(nu*(dx(incux) + dy(incuy)) - (2.0*nu - 1)*dx(incux))*dx(deltaux) - 2.0*(nu*(dx(incux) + dy(incuy)) - (2.0*nu - 1)*dy(incuy))*dy(deltauy))/((nu + 1.0)*(2.0*nu - 1)))
    + on(4,incux = 0)
    + on(4,incuy = 0)
 ;