varf pipecoolingwaterjacketradiationNewton([incu],[deltau]) = 
    int1d(Th, 3.00000000000000)(h*deltau*incu) 
 + int1d(Th, 2.00000000000000)(hC*deltau*incu) 
 - int1d(Th, 3.00000000000000)(-4.0*sigma*varepsilon*deltau*incu*u^3.0) 
 + int2d(Th)((1.00000000000000*(phi<0) + 0.000130000000000000*(1-(phi<0)))*k0*(dx(deltau)*dx(incu) + dy(deltau)*dy(incu)))
 ;