varf linearElasticityAdjoint([adjux, adjuy],[deltaux, deltauy]) = 
    int2d(Th)(0.5*(1.00000000000000*(phi<0) + 0.0100000000000000*(1-(phi<0)))*E*((2.0*nu - 1)*(dy(deltaux) + dx(deltauy))*(dy(adjux) + dx(adjuy)) - 2.0*(nu*(dx(deltaux) + dy(deltauy)) - (2.0*nu - 1)*dx(deltaux))*dx(adjux) - 2.0*(nu*(dx(deltaux) + dy(deltauy)) - (2.0*nu - 1)*dy(deltauy))*dy(adjuy))/((nu + 1.0)*(2.0*nu - 1))) 
 + int2d(Th)((1.00000000000000*(phi<0) + 0.0100000000000000*(1-(phi<0)))*E*((2.0*nu - 1)*(dy(deltaux) + dx(deltauy))*(dy(ux) + dx(uy)) - (nu*(dx(deltaux) + dy(deltauy)) - (2.0*nu - 1)*dx(deltaux))*dx(ux) - (nu*(dx(deltaux) + dy(deltauy)) - (2.0*nu - 1)*dy(deltauy))*dy(uy) - (nu*(dx(ux) + dy(uy)) - (2.0*nu - 1)*dx(ux))*dx(deltaux) - (nu*(dx(ux) + dy(uy)) - (2.0*nu - 1)*dy(uy))*dy(deltauy))/((nu + 1.0)*(2.0*nu - 1)))
    + on(4,adjux = 0)
    + on(4,adjuy = 0);

   matrix adjointMatrix = linearElasticityAdjoint(Vhu, Vhu);
   set(adjointMatrix, solver=sparsesolver);
   real[int] adjointrhs = linearElasticityAdjoint(0,Vhu);
   real[int] adjointsol = adjointMatrix^-1 * adjointrhs;
   adjointsol = -adjointsol; 
   [adjux[]] = adjointsol; 
