verbosity = 0;
load "iovtk"
include "include/inout.idp"
real ell = 100.000000000000;
real lambda = 1.00000000000000;
real f = -5;
real mu = 8.00000000000000;
// ###########################################
// ###########################################
// ###########################################
real timeStart = clock();

int n = 30;

mesh Th = square(4*n,n, [4*x,y]);

savemesh(Th,"Mesh1.mesh");
func phi0 = min(min(0.8 - y, max(max(-x, x - 0.15), max(-y, y - 0.8)) - 0.01), max(max(3.85 - x, x - 4.0), max(-y, y - 0.8)) - 0.01);
{savemesh(Th, "tmp/Mesh1.mesh");
fespace Vh1(Th, P1);
Vh1 phi;
phi = phi0;
printsol("tmp/phi.sol", phi[]);
int Res = system("mmg2d_O3 tmp/Mesh1.mesh -ls -sol tmp/phi.sol -hmin 0.25 -hmax 0.5 -hausd 0.001 -hgrad 1.3 -out tmp/newmesh.mesh -rmc -v -1");
 }
Th = readmesh("tmp/newmesh.mesh");
fespace VhPhi(Th, P1);
VhPhi phiTh;
phiTh = phi0;
func Vx = x * y + cos(4 * y);
func Vy = sin(4 * x);
func Vz = 0;
real objective = 0;
real objective0 = 0;
real shapeDerivative = 0;
{
fespace Vh1(Th,P1);
Vh1 phi, X0, X;
phi = phi0;
X0 = (phi<0); //characteristic function of the shape
// FE spaces
fespace Vhu(Th, [P2, P2]);
fespace Vhv(Th, [P2, P2]);
// FE fields for u
Vhu [ux, uy] = [0.,0.];
Vhu [incux, incuy];
// adjoint variables for u
Vhu [adjux, adjuy];
// definition of the test functions
Vhv [vx, vy];
include "include/linearElasticitybridgeNewton.edp"
include "include/linearElasticitybridgeResidual.edp"
   matrix A = linearElasticitybridgeNewton(Vhu, Vhv);
   set(A,solver=sparsesolver);
   real[int] rhs = linearElasticitybridgeResidual(0,Vhv);
   real[int] sol = A^-1 * rhs;
   // update state
   [incux[]] = sol; 
   ux[] -= incux[];
include "include/linearElasticitybridgeObjective.edp"
objective0 = objective;
// compute the adjoint and the shape derivative
include "include/linearElasticitybridgeAdjoint.edp"
include "include/linearElasticitybridgeShape.edp"
fespace VhV(Th, [P1, P1]);
VhV[shapeX, shapeY] = [0, 0];
shapeX[] = linearElasticitybridgeShape(0, VhV);
VhV[VdiscreteX, VdiscreteY] = [Vx, Vy];
shapeDerivative = VdiscreteX[]' * shapeX[];
}
mesh Thold = Th;
ofstream fout("convergenceShapelinearElasticitybridge.txt");
fout << "t, numShape, taylorShape" << endl;
for (int ii=0;ii<30;ii++){
 real t = 0.1*2.^(-real(ii));
 Th = movemesh(Thold,[x+t*Vx,y+t*Vy]);
fespace Vh1(Th,P1);
Vh1 phi, X0, X;
phi[] = phiTh[];
X0 = (phi<0); //characteristic function of the shape
// FE spaces
fespace Vhu(Th, [P2, P2]);
fespace Vhv(Th, [P2, P2]);
// FE fields for u
Vhu [ux, uy] = [0.,0.];
Vhu [incux, incuy];
// definition of the test functions
Vhv [vx, vy];
include "include/linearElasticitybridgeNewton.edp"
include "include/linearElasticitybridgeResidual.edp"
   matrix A = linearElasticitybridgeNewton(Vhu, Vhv);
   set(A,solver=sparsesolver);
   real[int] rhs = linearElasticitybridgeResidual(0,Vhv);
   real[int] sol = A^-1 * rhs;
   // update state
   [incux[]] = sol; 
   ux[] -= incux[];
include "include/linearElasticitybridgeObjective.edp"
real objective1 = objective;
real shapeDerivativeNumeric = (objective1 - objective0) / t;
fout << t << ", " << abs(shapeDerivativeNumeric-shapeDerivative) / abs(shapeDerivative) <<  ", " << abs(objective1 - objective0 - t * shapeDerivative) << ", "  << endl;
cout.precision(6);
cout.scientific;
cout << "t = " << t << ",  val. FD = " << shapeDerivativeNumeric << ", val. Formula = " << shapeDerivative 
     << ", error FD = " << abs(shapeDerivativeNumeric-shapeDerivative) / abs(shapeDerivative) 
     <<  ", error expansion = " << abs(objective1 - objective0 - t * shapeDerivative) << endl;
}
