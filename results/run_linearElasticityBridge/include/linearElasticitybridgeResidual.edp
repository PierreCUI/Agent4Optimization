varf linearElasticitybridgeResidual([incux, incuy],[vx, vy]) = 
    -int1d(Th, 3.00000000000000)(f*vy) 
 + int2d(Th)((1.00000000000000*(phi<0) + 0.00100000000000000*(1-(phi<0)))*(mu*(dy(ux) + dx(uy))*dy(vx) + mu*(dy(ux) + dx(uy))*dx(vy) + (lambda*(dx(ux) + dy(uy)) + 2.0*mu*dx(ux))*dx(vx) + (lambda*(dx(ux) + dy(uy)) + 2.0*mu*dy(uy))*dy(vy)))
    + on(2,incux = 0)
    + on(2,incuy = 0)
    + on(4,incux = 0)
    + on(4,incuy = 0)
 ;