varf nonlineardiffusionAdjoint([adju],[deltau]) = 
    int2d(Th)((1.00000000000000*(phi<0) + 0.100000000000000*(1-(phi<0)))*lambda0*(2.0*alpha*(dx(adju)*dx(u) + dy(adju)*dy(u))*deltau*u + (alpha*u^2.0 + 1.0)*(dx(deltau)*dx(adju) + dy(deltau)*dy(adju)))) 
 + int2d(Th)(2.0*(1.00000000000000*(phi<0) + 0.100000000000000*(1-(phi<0)))*lambda0*(alpha*(dx(u)^2.0 + dy(u)^2.0)*deltau*u + (alpha*u^2.0 + 1.0)*(dx(deltau)*dx(u) + dy(deltau)*dy(u))))
    + on(3,adju = 0);

   matrix adjointMatrix = nonlineardiffusionAdjoint(Vhu, Vhu);
   set(adjointMatrix, solver=sparsesolver);
   real[int] adjointrhs = nonlineardiffusionAdjoint(0,Vhu);
   real[int] adjointsol = adjointMatrix^-1 * adjointrhs;
   adjointsol = -adjointsol; 
   [adju[]] = adjointsol; 
