varf linearElasticityTargetmeshAdjoint([adjux, adjuy],[deltaux, deltauy]) = 
    int1d(Th, 999.000000000000)(c*(deltaux*adjux + deltauy*adjuy)) 
 + int2d(Th)((1.00000000000000*(phi<0) + 0*(1-(phi<0)))*(((x + ux - 1.0)^2.0 + (y + uy - 0.5)^2.0)^0.5 - 0.4)*((dx(ux) + 1.0)*dy(deltauy) + (dy(uy) + 1.0)*dx(deltaux) - dy(deltaux)*dx(uy) - dx(deltauy)*dy(ux))) 
 + int2d(Th)(0.5*(1.00000000000000*(phi<0) + 0.0100000000000000*(1-(phi<0)))*E*((2.0*nu - 1)*(dy(deltaux) + dx(deltauy))*(dy(adjux) + dx(adjuy)) - 2.0*(nu*(dx(deltaux) + dy(deltauy)) - (2.0*nu - 1)*dx(deltaux))*dx(adjux) - 2.0*(nu*(dx(deltaux) + dy(deltauy)) - (2.0*nu - 1)*dy(deltauy))*dy(adjuy))/((nu + 1.0)*(2.0*nu - 1)))
    + on(4,adjux = 0)
    + on(4,adjuy = 0);

   matrix adjointMatrix = linearElasticityTargetmeshAdjoint(Vhu, Vhu);
   set(adjointMatrix, solver=sparsesolver);
   real[int] adjointrhs = linearElasticityTargetmeshAdjoint(0,Vhu);
   real[int] adjointsol = adjointMatrix^-1 * adjointrhs;
   adjointsol = -adjointsol; 
   [adjux[]] = adjointsol; 
