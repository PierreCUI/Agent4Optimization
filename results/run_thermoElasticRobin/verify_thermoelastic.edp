verbosity = 0;
load "iovtk"
include "include/inout.idp"
real nu = 0.230000000000000;
real E0 = 32000000.0000000;
real rho = 2500;
real gamma = 100;
real g = 9.81000000000000;
real ell = 1;
real betaT = 100000000000.000;
real beta = 100000000000.000;
real k0 = 1.25000000000000;
real alphaT = 0.0000360000000000000;
real q = 5000;
// ###########################################
// ###########################################
// ###########################################
real timeStart = clock();


real bb = 0.2;

border C01(t=0, bb){x=t; y=0; label=5;}

border C02(t=0, 0.45*bb){x=bb; y=t; label=1;}

border C03(t=0, 0.05*bb){x=bb; y=0.45*bb+t; label=2;}

//border C04(t=0, 0.45*bb){x=bb; y=0.55*bb+t; label=1;}

border C05(t=0, bb){x=bb-t; y=bb/2; label=3;} // symmetry edge

border C06(t=0, bb/2){x=0.; y=bb/2-t; label=4;} // left edge

int n = 50;

//mesh Th = buildmesh(C01(n) + C02(n) + C03(n) + C05(n) + C06(n));

mesh Th = square(4*n,n,[4*x,y]);

savemesh(Th,"Mesh1.mesh");


func phi0 = -0.1 - cos(pi * x) * cos(pi * 3 * y)*(y<0.9)*(y>0.05) + (y<0.05);
{savemesh(Th, "tmp/Mesh1.mesh");
fespace Vh1(Th, P1);
Vh1 phi;
phi = phi0;
printsol("tmp/phi.sol", phi[]);
int Res = system("mmg2d_O3 tmp/Mesh1.mesh -ls -sol tmp/phi.sol -hmin 0.25 -hmax 0.5 -hausd 0.001 -hgrad 1.3 -out tmp/newmesh.mesh -rmc -v -1");
 }
Th = readmesh("tmp/newmesh.mesh");
fespace VhPhi(Th, P1);
VhPhi phiTh;
phiTh = phi0;
func Vx = x * y + cos(4 * y);
func Vy = sin(4 * x);
func Vz = 0;
real objective = 0;
real objective0 = 0;
real shapeDerivative = 0;
{
fespace Vh1(Th,P1);
Vh1 phi, X0, X;
phi = phi0;
X0 = (phi<0); //characteristic function of the shape
// FE spaces
fespace VhT(Th, P2);
fespace Vhu(Th, [P2, P2]);
fespace VhdeltaT(Th, P2);
fespace Vhdeltau(Th, [P2, P2]);
fespace Ch = <VhT*Vhu>;
fespace Cht = <VhdeltaT*Vhdeltau>;
// FE fields for T
VhT T = 0.;
VhT incT;
// adjoint variables for T
VhT adjT;
// FE fields for u
Vhu [ux, uy] = [0.,0.];
Vhu [incux, incuy];
// adjoint variables for u
Vhu [adjux, adjuy];
// definition of the test functions
VhdeltaT deltaT;
Vhdeltau [deltaux, deltauy];
include "include/thermoelasticNewton.edp"
include "include/thermoelasticResidual.edp"
   matrix A = thermoelasticNewton(Ch, Cht);
   set(A,solver=sparsesolver);
   real[int] rhs = thermoelasticResidual(0,Cht);
   real[int] sol = A^-1 * rhs;
   // update state
   [incT[],incux[]] = sol; 
   T[] -= incT[];
   ux[] -= incux[];
include "include/thermoelasticObjective.edp"
objective0 = objective;
// compute the adjoint and the shape derivative
include "include/thermoelasticAdjoint.edp"
include "include/thermoelasticShape.edp"
fespace VhV(Th, [P1, P1]);
VhV[shapeX, shapeY] = [0, 0];
shapeX[] = thermoelasticShape(0, VhV);
VhV[VdiscreteX, VdiscreteY] = [Vx, Vy];
shapeDerivative = VdiscreteX[]' * shapeX[];
}
mesh Thold = Th;
ofstream fout("convergenceShapethermoelastic.txt");
fout << "t, numShape, taylorShape" << endl;
for (int ii=0;ii<30;ii++){
 real t = 0.1*2.^(-real(ii));
 Th = movemesh(Thold,[x+t*Vx,y+t*Vy]);
fespace Vh1(Th,P1);
Vh1 phi, X0, X;
phi[] = phiTh[];
X0 = (phi<0); //characteristic function of the shape
// FE spaces
fespace VhT(Th, P2);
fespace Vhu(Th, [P2, P2]);
fespace VhdeltaT(Th, P2);
fespace Vhdeltau(Th, [P2, P2]);
fespace Ch = <VhT*Vhu>;
fespace Cht = <VhdeltaT*Vhdeltau>;
// FE fields for T
VhT T = 0.;
VhT incT;
// FE fields for u
Vhu [ux, uy] = [0.,0.];
Vhu [incux, incuy];
// definition of the test functions
VhdeltaT deltaT;
Vhdeltau [deltaux, deltauy];
include "include/thermoelasticNewton.edp"
include "include/thermoelasticResidual.edp"
   matrix A = thermoelasticNewton(Ch, Cht);
   set(A,solver=sparsesolver);
   real[int] rhs = thermoelasticResidual(0,Cht);
   real[int] sol = A^-1 * rhs;
   // update state
   [incT[],incux[]] = sol; 
   T[] -= incT[];
   ux[] -= incux[];
include "include/thermoelasticObjective.edp"
real objective1 = objective;
real shapeDerivativeNumeric = (objective1 - objective0) / t;
fout << t << ", " << abs(shapeDerivativeNumeric-shapeDerivative) / abs(shapeDerivative) <<  ", " << abs(objective1 - objective0 - t * shapeDerivative) << ", "  << endl;
cout.precision(6);
cout.scientific;
cout << "t = " << t << ",  val. FD = " << shapeDerivativeNumeric << ", val. Formula = " << shapeDerivative 
     << ", error FD = " << abs(shapeDerivativeNumeric-shapeDerivative) / abs(shapeDerivative) 
     <<  ", error expansion = " << abs(objective1 - objective0 - t * shapeDerivative) << endl;
}
