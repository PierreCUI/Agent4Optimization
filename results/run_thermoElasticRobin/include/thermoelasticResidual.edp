varf thermoelasticResidual([incT, incux, incuy],[deltaT, deltaux, deltauy]) = 
    int1d(Th, 2.00000000000000)(beta*(deltaux*ux + deltauy*uy)) 
 + int1d(Th, 4.00000000000000)(beta*(deltaux*ux + deltauy*uy)) 
 + int1d(Th, 3.00000000000000)(q*deltauy) 
 - int1d(Th, 4.00000000000000)(30.0*betaT*y*deltaT) 
 + int1d(Th, 4.00000000000000)(betaT*T*deltaT) 
 + int2d(Th)((k0*(phi<0) + 0.001*k0*(1-(phi<0)))*(dx(T)*dx(deltaT) + dy(T)*dy(deltaT))) 
 + int2d(Th)((1.00000000000000*(phi<0) + 0*(1-(phi<0)))*g*rho*deltauy) 
 + int2d(Th)(0.5*(E0*(phi<0) + 0.001*E0*(1-(phi<0)))*((2.0*nu - 1)*(dy(deltaux) + dx(deltauy))*(dy(ux) + dx(uy)) - 2.0*(nu*(-2.0*(alphaT*(phi<0) + 0.001*alphaT*(1-(phi<0)))*T + dx(ux) + dy(uy)) + (2.0*nu - 1)*((alphaT*(phi<0) + 0.001*alphaT*(1-(phi<0)))*T - dx(ux)))*dx(deltaux) - 2.0*(nu*(-2.0*(alphaT*(phi<0) + 0.001*alphaT*(1-(phi<0)))*T + dx(ux) + dy(uy)) + (2.0*nu - 1)*((alphaT*(phi<0) + 0.001*alphaT*(1-(phi<0)))*T - dy(uy)))*dy(deltauy))/((nu + 1.0)*(2.0*nu - 1)))
 ;