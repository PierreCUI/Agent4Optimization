varf thermoelasticShape([Ax, Ay],[Vx, Vy], tgv=-2) = 
    -int1d(Th, 2.00000000000000)(beta*(N.x*(N.x*dx(Vx) + N.y*dx(Vy)) + N.y*(N.x*dy(Vx) + N.y*dy(Vy)))*(adjux*ux + adjuy*uy)) 
 - int1d(Th, 4.00000000000000)(beta*(N.x*(N.x*dx(Vx) + N.y*dx(Vy)) + N.y*(N.x*dy(Vx) + N.y*dy(Vy)))*(adjux*ux + adjuy*uy)) 
 - int1d(Th, 2.00000000000000)(beta*(N.x*(N.x*dx(Vx) + N.y*dx(Vy)) + N.y*(N.x*dy(Vx) + N.y*dy(Vy)))*ux^2.0) 
 - int1d(Th, 4.00000000000000)(beta*(N.x*(N.x*dx(Vx) + N.y*dx(Vy)) + N.y*(N.x*dy(Vx) + N.y*dy(Vy)))*ux^2.0) 
