 + int1d(Th, 4.00000000000000)(beta*(adjux*ux + adjuy*uy)*(dx(Vx) + dy(Vy))) 
 + int1d(Th, 2.00000000000000)(beta*(dx(Vx) + dy(Vy))*ux^2.0) 
 + int1d(Th, 4.00000000000000)(beta*(dx(Vx) + dy(Vy))*ux^2.0) 
 - int1d(Th, 4.00000000000000)(30.0*betaT*Vy*adjT) 
 + int1d(Th, 3.00000000000000)(gamma*(N.x*(N.x*dx(Vx) + N.y*dx(Vy)) + N.y*(N.x*dy(Vx) + N.y*dy(Vy)))*uy) 
 - int1d(Th, 3.00000000000000)(gamma*(dx(Vx) + dy(Vy))*uy) 
 - int1d(Th, 3.00000000000000)(q*(N.x*(N.x*dx(Vx) + N.y*dx(Vy)) + N.y*(N.x*dy(Vx) + N.y*dy(Vy)))*adjuy) 
 + int1d(Th, 3.00000000000000)(q*(dx(Vx) + dy(Vy))*adjuy) 
 + int1d(Th, 4.00000000000000)(30.0*betaT*y*(N.x*(N.x*dx(Vx) + N.y*dx(Vy)) + N.y*(N.x*dy(Vx) + N.y*dy(Vy)))*adjT) 
 - int1d(Th, 4.00000000000000)(30.0*betaT*y*(dx(Vx) + dy(Vy))*adjT) 
 - int1d(Th, 4.00000000000000)(betaT*(N.x*(N.x*dx(Vx) + N.y*dx(Vy)) + N.y*(N.x*dy(Vx) + N.y*dy(Vy)))*T*adjT) 
 + int1d(Th, 4.00000000000000)(betaT*(dx(Vx) + dy(Vy))*T*adjT) 
 + int2d(Th)((k0*(phi<0) + 0.001*k0*(1-(phi<0)))*(-dx(T)*dx(Vx)*dx(adjT) - dx(T)*dy(Vx)*dy(adjT) - dx(T)*dx(Vy)*dy(adjT) + dx(T)*dy(Vy)*dx(adjT) + dy(T)*dx(Vx)*dy(adjT) - dy(T)*dy(Vx)*dx(adjT) - dy(T)*dx(Vy)*dx(adjT) - dy(T)*dy(Vy)*dy(adjT))) 
 + int2d(Th)((1.00000000000000*(phi<0) + 0*(1-(phi<0)))*ell*(dx(Vx) + dy(Vy))) 
 + int2d(Th)(0.5*(E0*(phi<0) + 0.001*E0*(1-(phi<0)))*(-(2.0*nu - 1)*((dy(adjux) + dx(adjuy))*(dx(Vx)*dx(uy) + dy(Vx)*dx(ux) + dx(Vy)*dy(uy) + dy(Vy)*dy(ux)) + (dy(ux) + dx(uy))*(dx(Vx)*dx(adjuy) + dy(Vx)*dx(adjux) + dx(Vy)*dy(adjuy) + dy(Vy)*dy(adjux))) + 2.0*(nu*(-2.0*(alphaT*(phi<0) + 0.001*alphaT*(1-(phi<0)))*T + dx(ux) + dy(uy)) + (2.0*nu - 1)*((alphaT*(phi<0) + 0.001*alphaT*(1-(phi<0)))*T - dx(ux)))*(dx(Vx)*dx(adjux) + dx(Vy)*dy(adjux)) + 2.0*(nu*(-2.0*(alphaT*(phi<0) + 0.001*alphaT*(1-(phi<0)))*T + dx(ux) + dy(uy)) + (2.0*nu - 1)*((alphaT*(phi<0) + 0.001*alphaT*(1-(phi<0)))*T - dy(uy)))*(dy(Vx)*dx(adjuy) + dy(Vy)*dy(adjuy)) + 2.0*(nu*(dx(Vx)*dx(ux) + dy(Vx)*dx(uy) + dx(Vy)*dy(ux) + dy(Vy)*dy(uy)) - (2.0*nu - 1)*(dx(Vx)*dx(ux) + dx(Vy)*dy(ux)))*dx(adjux) + 2.0*(nu*(dx(Vx)*dx(ux) + dy(Vx)*dx(uy) + dx(Vy)*dy(ux) + dy(Vy)*dy(uy)) - (2.0*nu - 1)*(dy(Vx)*dx(uy) + dy(Vy)*dy(uy)))*dy(adjuy) - (dx(Vx) + dy(Vy))*(-(2.0*nu - 1)*(dy(adjux) + dx(adjuy))*(dy(ux) + dx(uy)) + 2.0*(nu*(-2.0*(alphaT*(phi<0) + 0.001*alphaT*(1-(phi<0)))*T + dx(ux) + dy(uy)) + (2.0*nu - 1)*((alphaT*(phi<0) + 0.001*alphaT*(1-(phi<0)))*T - dx(ux)))*dx(adjux) + 2.0*(nu*(-2.0*(alphaT*(phi<0) + 0.001*alphaT*(1-(phi<0)))*T + dx(ux) + dy(uy)) + (2.0*nu - 1)*((alphaT*(phi<0) + 0.001*alphaT*(1-(phi<0)))*T - dy(uy)))*dy(adjuy)))/((nu + 1.0)*(2.0*nu - 1))) 
 + int2d(Th)((1.00000000000000*(phi<0) + 0*(1-(phi<0)))*g*rho*(dx(Vx) + dy(Vy))*adjuy);